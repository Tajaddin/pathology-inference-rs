# Copy to .env. Every value has a working local default; nothing here is a real secret.

# --- Rust service
PORT=8080
# /metrics for Prometheus; internal only, never published (Cloud Run routes only PORT).
METRICS_PORT=9464
MODEL_PATH=models/pcam/1/model.onnx
MODEL_META_PATH=models/pcam/1/model.json
# client:key pairs, keys at least 16 characters. In GCP they come from Secret Manager.
API_KEYS=viewer:local-dev-key-viewer-000001,loadtest:local-dev-key-loadtest-0001
RATE_LIMIT_PER_MINUTE=6000
# client:patches_per_minute:max_windows in place of the defaults. The viewer's key ships in its JavaScript bundle,
# so it is public once the viewer is hosted: keep its quota and tile cap low.
CLIENT_LIMITS=viewer:1200:256
# Measured on 4 CPUs (reports/k6): 4 workers x 1 thread and a 0.5 ms window beat 2 x 2 and 2 ms.
WORKERS=4
INTRA_THREADS=1
MAX_BATCH=32
MAX_WAIT_US=500
MAX_PATCHES_PER_REQUEST=64
# Heatmap windows per request (a 2048 px tile at stride 32 has 3,844).
MAX_WINDOWS_PER_REQUEST=4096
# Patches of model input queued or running at once, across all requests: 108 KiB each, so 512 is 54 MiB.
MAX_INFLIGHT_PATCHES=512
# Patches of admitted requests not yet answered (at least MAX_WINDOWS_PER_REQUEST): under overload, about how
# much work an admitted request waits behind. A request that gets no room within ADMIT_TIMEOUT_MS gets 503.
MAX_PENDING_PATCHES=4096
ADMIT_TIMEOUT_MS=1000
MAX_TILE_SIDE=2048
MIN_STRIDE=32
CORS_ORIGINS=http://localhost:8088,http://localhost:5173
RUST_LOG=info,ort=warn

# --- Viewer (baked in at build time by Vite)
VITE_SERVICE_URL=http://localhost:8080
VITE_API_KEY=local-dev-key-viewer-000001
