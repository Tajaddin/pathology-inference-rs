# Copy to .env. Every value has a working local default; nothing here is a real secret.

# --- Rust service
PORT=8080
MODEL_PATH=models/pcam/1/model.onnx
MODEL_META_PATH=models/pcam/1/model.json
# client:key pairs, keys at least 16 characters. In GCP they come from Secret Manager.
API_KEYS=viewer:local-dev-key-viewer-000001,loadtest:local-dev-key-loadtest-0001
RATE_LIMIT_PER_MINUTE=6000
WORKERS=2
INTRA_THREADS=4
MAX_BATCH=32
MAX_WAIT_US=2000
MAX_PATCHES_PER_REQUEST=64
MAX_TILE_SIDE=2048
MIN_STRIDE=32
CORS_ORIGINS=http://localhost:8088,http://localhost:5173
RUST_LOG=info,ort=warn

# --- Viewer (baked in at build time by Vite)
VITE_SERVICE_URL=http://localhost:8080
VITE_API_KEY=local-dev-key-viewer-000001
