{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "client/src/**/*.js",
    "client/test/**/*.js",
    "viewer/src/**/*.js"
  ]
}
